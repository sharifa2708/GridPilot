# Copy this file to ".env" (same folder) and paste your key after the equals sign.
# The .env file is git-ignored and is never sent anywhere except to api.anthropic.com.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed if Anthropic says your key "is not scoped to a workspace":
# ANTHROPIC_WORKSPACE_ID=
